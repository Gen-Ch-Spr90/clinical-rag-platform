# PostgreSQL
POSTGRES_DB=clinicalrag
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me

# Embedding provider: mock | openai | bedrock
EMBEDDING_PROVIDER=openai

# LLM provider: mock | openai 
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Vector dimensions — must match the embedding model
EMBEDDING_DIMENSIONS=1536

# Server
SERVER_PORT=8081


EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai
OPENAI_API_KEY=OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_KEY


# OpenAI (required if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30